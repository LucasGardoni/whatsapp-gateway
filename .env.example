PORT=8080
DATABASE_URL=postgres://gateway:gateway@localhost:5432/whatsapp_gateway



# origens exatas autorizadas a abrir o EventSource de /eventos (P0-03), separadas
# por virgula (CRM, portal). Nunca "*": o token de sessao viaja na query string.
# Vazio nao emite o header.
CORS_ORIGEM_CRM=http://localhost:8081

# segredo no path dos webhooks de entrada (P1-10). Obrigatorio pra expor o
# gateway na internet: sem ele os webhooks respondem 404. Desde o G1 ele e o
# segredo da caixa semente (CAIXA_CODIGO) na z-api e o do webhook de leads;
# cada outra caixa tem o seu em caixa.webhook_segredo. Apenas
# [A-Za-z0-9._~-] -- vira segmento de URL. Gere com:
#   powershell -c "-join((1..16)|%{'{0:x2}' -f (Get-Random -Max 256)})"
WEBHOOK_PATH_SECRET=

# credenciais da caixa semente (G1): copiadas para a linha dela em `caixa` a
# cada subida. As outras caixas guardam as proprias credenciais no banco.
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=

META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

MIDIA_DIR=./dados/midia

PUBLIC_BASE_URL=http://localhost:8080

DLP_DOMINIOS_PERMITIDOS=
DLP_SOMENTE_AVISAR=false

# limite por IP dos endpoints publicos (webhooks, /disparos, /c/{token}).
# <= 0 desliga.
RATE_LIMIT_POR_MINUTO=60

# limite por APLICACAO das rotas autenticadas (fase 9 do barramento).
# Mais alto que o por IP de proposito: aqui o chamador e um backend
# identificado, que legitimamente faz rajada (disparo, importacao de CSV).
# O que este numero contem e laco de integracao. <= 0 desliga.
#
# Para apertar UMA aplicacao sem mexer aqui nem reiniciar:
#   UPDATE aplicacao SET limite_requisicoes_por_minuto = 60 WHERE codigo = 'portal';
RATE_LIMIT_APLICACAO_POR_MINUTO=600

# teto de conteudo_cifrado por mensagem interna, em bytes (fase 9).
# Conservador: mensagem de chat cifrada nao chega perto disso, e sem teto
# uma aplicacao com bug de laco enche a tabela que todas compartilham.
# <= 0 NAO desliga -- cai no default de 65536.
#
# Por aplicacao:
#   UPDATE aplicacao SET limite_conteudo_cifrado_bytes = 16384 WHERE codigo = 'portal';
LIMITE_CONTEUDO_CIFRADO_BYTES=65536

SSE_SIGNING_KEY=

# Caixa semente e padrao (G1, ver docs/PLANO_MULTICAIXA_E_CONVERSAS.md): a
# que recebe as credenciais e o segredo acima, e a usada quando a aplicacao
# nao informa `caixa`. A migration 00026 cria a semente como rod_lider; se
# este valor for outro, renomeie a linha antes de subir
# (UPDATE caixa SET codigo = '...' WHERE codigo = 'rod_lider'), senao nasce
# uma caixa nova e as conversas antigas ficam na semente. Precisa bater com
# crm_caixa.codigo do portal.
CAIXA_CODIGO=rod_lider

# G8: aplicacoes que recebem os eventos de WhatsApp de cada caixa na chave
# "<app>:caixa:<codigo da caixa>" (destino "caixa:<codigo>" em POST /v1/sessoes),
# alem do caminho do CRM. Separadas por virgula. Vazio = so o CRM.
EVENTOS_WHATSAPP_APLICACOES=
